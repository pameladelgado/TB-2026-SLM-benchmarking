    "    {\"metric\": \"vram_used_mb_peak\", \"unit\": \"MB\", \"level\": \"sample/summary\", \"meaning\": \"Peak GPU memory used\"},\n",
    "    {\"metric\": \"power_w_avg\", \"unit\": \"W\", \"level\": \"sample/summary\", \"meaning\": \"Average GPU power draw\"},\n",
    "    {\"metric\": \"power_w_peak\", \"unit\": \"W\", \"level\": \"sample/summary\", \"meaning\": \"Peak GPU power draw\"},\n",
    "    {\"metric\": \"energy_j\", \"unit\": \"J\", \"level\": \"derived\", \"meaning\": \"Approx. GPU energy = average power W × latency seconds\"},\n",
