    "\n",
    "def collapse_duplicate_columns(df: pd.DataFrame) -> pd.DataFrame:\n",
    "    \"\"\"Merge duplicate column names by taking the first non-null value row-wise.\"\"\"\n",
    "    if df.empty:\n",
    "        return df.copy()\n",
    "    out = pd.DataFrame(index=df.index)\n",
    "    for col in dict.fromkeys(df.columns):\n",
    "        block = df.loc[:, df.columns == col]\n",
    "        if block.shape[1] == 1:\n",
    "            out[col] = block.iloc[:, 0]\n",
    "        else:\n",
    "            out[col] = block.bfill(axis=1).iloc[:, 0]\n",
    "    return out.reset_index(drop=True)\n",
    "\n",
    "\n",
    "def first_existing(df: pd.DataFrame, candidates, default=np.nan):\n",
    "    for c in candidates:\n",
    "        if c in df.columns:\n",
    "            return df[c]\n",
    "    return pd.Series(default, index=df.index)\n",
    "\n",
    "\n",
    "def to_num(s):\n",
    "    return pd.to_numeric(s, errors=\"coerce\")\n",
    "\n",
    "\n",
    "def to_bool_or_nan(s):\n",
    "    if s is None:\n",
    "        return np.nan\n",
    "    if not isinstance(s, pd.Series):\n",
    "        return s\n",
    "    def conv(x):\n",
    "        if pd.isna(x):\n",
    "            return np.nan\n",
    "        if isinstance(x, bool):\n",
    "            return x\n",
    "        text = str(x).strip().lower()\n",
    "        if text in {\"true\", \"1\", \"yes\", \"y\"}:\n",
    "            return True\n",
    "        if text in {\"false\", \"0\", \"no\", \"n\"}:\n",
    "            return False\n",
    "        return np.nan\n",
    "    return s.map(conv)\n",
    "\n",
    "\n",
    "def safe_div(num, den):\n",
    "    num = to_num(num)\n",
    "    den = to_num(den)\n",
    "    return np.where((den.notna()) & (den != 0), num / den, np.nan)\n",
    "\n",
    "\n",
    "def add_common_labels(df: pd.DataFrame) -> pd.DataFrame:\n",
    "    df = collapse_duplicate_columns(df)\n",
    "    if df.empty:\n",
    "        return df\n",
    "    if \"platform\" not in df.columns:\n",
    "        df[\"platform\"] = PLATFORM\n",
    "    if \"dataset\" in df.columns:\n",
    "        df[\"dataset\"] = df[\"dataset\"].astype(str).str.lower()\n",
    "    if \"model\" not in df.columns:\n",
    "        df[\"model\"] = first_existing(df, [\"model_name\", \"Model name\", \"model_alias\", \"Model alias\", \"model_dir\", \"model_alias_dir\", \"Repo id\", \"repo_id\"])\n",
    "    df[\"model\"] = df[\"model\"].astype(str)\n",
    "    df[\"model_label\"] = df[\"platform\"].astype(str) + \" | \" + df[\"model\"].astype(str)\n",
    "    if \"run_id\" in df.columns:\n",
    "        df[\"run_label\"] = df[\"platform\"].astype(str) + \" | \" + df[\"model\"].astype(str) + \" | \" + df[\"run_id\"].astype(str)\n",
    "    return df\n",
    "\n",
    "def normalize_summary(raw: pd.DataFrame) -> pd.DataFrame:\n",
    "    raw = add_common_labels(raw)\n",
    "    if raw.empty:\n",
    "        return raw\n",
    "    out = pd.DataFrame(index=raw.index)\n",
    "    for col in [\"platform\", \"dataset\", \"run_id\", \"run_dir\", \"model\", \"model_label\", \"model_alias_dir\", \"source_file\"]:\n",
    "        if col in raw.columns:\n",
    "            out[col] = raw[col]\n",
    "    if \"repo_id\" not in out.columns:\n",
    "        out[\"repo_id\"] = first_existing(raw, [\"Repo id\", \"repo_id\", \"served_model_id\"])\n",
    "\n",
    "    out[\"accuracy\"] = to_num(first_existing(raw, [\"Accuracy mean\"]))\n",
    "    out[\"accuracy_sd\"] = to_num(first_existing(raw, [\"Accuracy sd\"]))\n",
    "    out[\"ttft_ms\"] = to_num(first_existing(raw, [\"TTFT ms mean\"]))\n",
    "    out[\"ttft_ms_sd\"] = to_num(first_existing(raw, [\"TTFT ms sd\"]))\n",
    "    out[\"latency_ms\"] = to_num(first_existing(raw, [\"End-to-end latency ms mean\"]))\n",
    "    out[\"latency_ms_sd\"] = to_num(first_existing(raw, [\"End-to-end latency ms sd\"]))\n",
    "    out[\"tokens_per_sec\"] = to_num(first_existing(raw, [\"Tokens/sec mean\"]))\n",
    "    out[\"tokens_per_sec_sd\"] = to_num(first_existing(raw, [\"Tokens/sec sd\"]))\n",
    "    out[\"sustained_tokens_per_sec\"] = to_num(first_existing(raw, [\"Sequential sustained tokens/sec mean\"]))\n",
    "    out[\"sustained_tokens_per_sec_sd\"] = to_num(first_existing(raw, [\"Sequential sustained tokens/sec sd\"]))\n",
    "    out[\"samples_per_sec\"] = to_num(first_existing(raw, [\"Sequential sustained samples/sec mean\"]))\n",
    "    out[\"samples_per_sec_sd\"] = to_num(first_existing(raw, [\"Sequential sustained samples/sec sd\"]))\n",
    "    out[\"cpu_percent_avg\"] = to_num(first_existing(raw, [\"CPU percent avg mean\"]))\n",
    "    out[\"cpu_percent_avg_sd\"] = to_num(first_existing(raw, [\"CPU percent avg sd\"]))\n",
    "    out[\"cpu_percent_peak\"] = to_num(first_existing(raw, [\"CPU percent peak\"]))\n",
    "    out[\"ram_used_mb_peak\"] = to_num(first_existing(raw, [\"RAM used MB peak\"]))\n",
    "    out[\"process_ram_mb_peak\"] = to_num(first_existing(raw, [\"Process RAM MB peak\"]))\n",
    "    out[\"temperature_c_avg\"] = to_num(first_existing(raw, [\"Temp C avg mean\"]))\n",
    "    out[\"temperature_c_avg_sd\"] = to_num(first_existing(raw, [\"Temp C avg sd\"]))\n",
    "    out[\"temperature_c_peak\"] = to_num(first_existing(raw, [\"Temp C peak\"]))\n",
    "    out[\"gpu_util_percent_avg\"] = to_num(first_existing(raw, [\"GPU percent avg mean\"]))\n",
    "    out[\"gpu_util_percent_avg_sd\"] = to_num(first_existing(raw, [\"GPU percent avg sd\"]))\n",
    "    out[\"gpu_util_percent_peak\"] = to_num(first_existing(raw, [\"GPU percent peak\"]))\n",
    "    out[\"vram_used_mb_peak\"] = to_num(first_existing(raw, [\"VRAM used MB peak\"]))\n",
    "    out[\"power_w_avg\"] = to_num(first_existing(raw, [\"Power W avg mean\"]))\n",
    "    out[\"power_w_avg_sd\"] = to_num(first_existing(raw, [\"Power W avg sd\"]))\n",
    "    out[\"power_w_peak\"] = to_num(first_existing(raw, [\"Power W peak\"]))\n",
    "\n",
    "    # Summary-level energy approximates one average sample from mean power and mean latency.\n",
    "    out[\"energy_j\"] = out[\"power_w_avg\"] * out[\"latency_ms\"] / 1000.0\n",
    "    out[\"energy_per_token_j\"] = np.nan  # sample-level table has the reliable value\n",
    "    out[\"tokens_per_joule\"] = np.nan\n",
    "    out[\"has_accuracy\"] = out[\"dataset\"].isin(SCORED_DATASETS) & out[\"accuracy\"].notna()\n",
    "    out[\"accuracy_per_second\"] = safe_div(out[\"accuracy\"], out[\"latency_ms\"] / 1000.0)\n",
    "    out[\"accuracy_per_joule\"] = safe_div(out[\"accuracy\"], out[\"energy_j\"])\n",
    "    return out\n",
    "\n",
    "\n",
    "def normalize_samples(raw: pd.DataFrame) -> pd.DataFrame:\n",
    "    raw = add_common_labels(raw)\n",
    "    if raw.empty:\n",
    "        return raw\n",
    "    out = pd.DataFrame(index=raw.index)\n",
    "    keep_cols = [\n",
    "        \"platform\", \"dataset\", \"run_id\", \"run_dir\", \"model\", \"model_label\", \"model_alias_dir\", \"source_file\",\n",
    "        \"repo_id\", \"served_model_id\", \"sample_idx\", \"prompt\", \"question\", \"choices\", \"instruction\", \"context\", \"gold_answer\",\n",
    "        \"parsed_prediction\", \"raw_output\", \"system_metrics_trace_json\",\n",
    "    ]\n",
    "    for col in keep_cols:\n",
    "        if col in raw.columns:\n",
    "            out[col] = raw[col]\n",
    "    if \"repo_id\" not in out.columns:\n",
    "        out[\"repo_id\"] = first_existing(raw, [\"repo_id\", \"Repo id\", \"served_model_id\"])\n",
    "    out[\"correct\"] = to_bool_or_nan(first_existing(raw, [\"correct\"]))\n",
    "    out[\"accuracy\"] = out[\"correct\"].astype(float)\n",
    "    out.loc[~out[\"dataset\"].isin(SCORED_DATASETS), \"accuracy\"] = np.nan\n",
    "    out[\"output_tokens\"] = to_num(first_existing(raw, [\"output_tokens\"]))\n",
    "    out[\"ttft_ms\"] = to_num(first_existing(raw, [\"ttft_ms\"]))\n",
    "    out[\"latency_ms\"] = to_num(first_existing(raw, [\"end_to_end_latency_ms\", \"latency_ms\"]))\n",
    "    out[\"tokens_per_sec\"] = to_num(first_existing(raw, [\"tokens_per_sec\"]))\n",
    "    out[\"cpu_percent_avg\"] = to_num(first_existing(raw, [\"cpu_percent_avg\"]))\n",
    "    out[\"cpu_percent_peak\"] = to_num(first_existing(raw, [\"cpu_percent_peak\"]))\n",
    "    out[\"ram_used_mb_peak\"] = to_num(first_existing(raw, [\"ram_used_mb_peak\"]))\n",
    "    out[\"process_ram_mb_peak\"] = to_num(first_existing(raw, [\"process_ram_mb_peak\"]))\n",
    "    out[\"temperature_c_avg\"] = to_num(first_existing(raw, [\"temp_c_avg\", \"temperature_c_avg\"]))\n",
    "    out[\"temperature_c_peak\"] = to_num(first_existing(raw, [\"temp_c_peak\", \"temperature_c_peak\"]))\n",
    "    out[\"gpu_util_percent_avg\"] = to_num(first_existing(raw, [\"gpu_util_percent_avg\"]))\n",
    "    out[\"gpu_util_percent_peak\"] = to_num(first_existing(raw, [\"gpu_util_percent_peak\"]))\n",
    "    out[\"vram_used_mb_peak\"] = to_num(first_existing(raw, [\"vram_used_mb_peak\"]))\n",
    "    out[\"power_w_avg\"] = to_num(first_existing(raw, [\"power_w_avg\"]))\n",
    "    out[\"power_w_peak\"] = to_num(first_existing(raw, [\"power_w_peak\"]))\n",
    "    out[\"energy_j\"] = out[\"power_w_avg\"] * out[\"latency_ms\"] / 1000.0\n",
    "    out[\"energy_per_token_j\"] = safe_div(out[\"energy_j\"], out[\"output_tokens\"])\n",
    "    out[\"tokens_per_joule\"] = safe_div(out[\"output_tokens\"], out[\"energy_j\"])\n",
    "    out[\"accuracy_per_second\"] = safe_div(out[\"accuracy\"], out[\"latency_ms\"] / 1000.0)\n",
    "    out[\"accuracy_per_joule\"] = safe_div(out[\"accuracy\"], out[\"energy_j\"])\n",
    "    return out\n"
   ]
