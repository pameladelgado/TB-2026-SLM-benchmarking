# Python cache
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
build/
dist/
*.egg-info/

# Jupyter notebooks
.ipynb_checkpoints/

# IDEs / editors
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
*.out

# Benchmark outputs
results/raw/*
results/processed/*
!results/raw/.gitkeep
!results/processed/.gitkeep

# Models (very important: models are huge)
models/*
!models/.gitkeep

# Model weights (in case they appear elsewhere)
*.gguf
*.bin
*.safetensors
*.pt

# llama.cpp build artifacts
engines/llama.cpp/build/
engines/llama.cpp/*.o
engines/llama.cpp/*.a
engines/llama.cpp/*.so

# CUDA build artifacts
*.cu.o

# Temporary experiment files
*.tmp

# Python tool environments
.python-version

# Hugging Face / vLLM caches (inside repo)
.cache/
huggingface/
.vllm/
hf_cache/
